generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                            Int                  @id @default(autoincrement())
  nombre                                        String
  email                                         String               @unique
  passwordHash                                  String?
  rolId                                         Int
  telefono                                      String?
  cedula                                        String?              @unique
  esMayorDeEdad                                 Boolean              @default(true)
  estado                                        String               @default("inactivo")
  googleId                                      String?              @unique
  fechaRegistro                                 DateTime             @default(now())
  fotoPerfil                                    String?
  Calificacion_Calificacion_calificadoIdToUser  Calificacion[]       @relation("Calificacion_calificadoIdToUser")
  Calificacion_Calificacion_calificadorIdToUser Calificacion[]       @relation("Calificacion_calificadorIdToUser")
  Cliente                                       Cliente?
  Freelancer                                    Freelancer?
  MeGustaPublicacion                            MeGustaPublicacion[]
  Mensaje                                       Mensaje[]
  Publicacion                                   Publicacion[]
  tokens                                        RecoveryToken[]
  Reporte_Reporte_adminIdToUser                 Reporte[]            @relation("Reporte_adminIdToUser")
  Reporte_Reporte_usuarioReportaIdToUser        Reporte[]            @relation("Reporte_usuarioReportaIdToUser")
  Reporte_Reporte_usuarioReportadoIdToUser      Reporte[]            @relation("Reporte_usuarioReportadoIdToUser")
  Rol                                           Rol                  @relation(fields: [rolId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([rolId])
}

model RecoveryToken {
  id              Int      @id @default(autoincrement())
  usuarioId       Int
  token           String   @unique
  fechaExpiracion DateTime
  usado           Boolean  @default(false)
  usuario         User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Calificacion {
  id                                    Int      @id @default(autoincrement())
  contratoId                            Int
  calificadorId                         Int
  calificadoId                          Int
  puntuacion                            Int      @db.SmallInt
  comentario                            String?
  fecha                                 DateTime @default(now())
  User_Calificacion_calificadoIdToUser  User     @relation("Calificacion_calificadoIdToUser", fields: [calificadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User_Calificacion_calificadorIdToUser User     @relation("Calificacion_calificadorIdToUser", fields: [calificadorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Contrato                              Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([contratoId, calificadorId])
  @@index([calificadoId])
}

model Categoria {
  id          Int         @id @default(autoincrement())
  nombre      String      @unique @db.VarChar(100)
  descripcion String?
  Habilidad   Habilidad[]
  Proyecto    Proyecto[]
  Servicio    Servicio[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Cliente {
  id            Int            @id
  nombreEmpresa String?        @db.VarChar(150)
  tipoCliente   String         @default("natural") @db.VarChar(20)
  descripcion   String?
  User          User           @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Contrato      Contrato[]
  Conversacion  Conversacion[]
  Proyecto      Proyecto[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Contrato {
  id            Int            @id @default(autoincrement())
  propuestaId   Int?           @unique
  proyectoId    Int?
  servicioId    Int?
  ofertaChatId  Int?           @unique
  clienteId     Int
  freelancerId  Int
  montoAcordado Decimal        @db.Decimal(12, 2)
  fechaInicio   DateTime?      @db.Date
  fechaFin      DateTime?      @db.Date
  estado        String         @default("activo") @db.VarChar(20)
  Calificacion  Calificacion[]
  Cliente       Cliente        @relation(fields: [clienteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Freelancer    Freelancer     @relation(fields: [freelancerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  OfertaChat    OfertaChat?    @relation(fields: [ofertaChatId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Propuesta     Propuesta?     @relation(fields: [propuestaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Proyecto      Proyecto?      @relation(fields: [proyectoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Servicio      Servicio?      @relation(fields: [servicioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Pago          Pago[]

  @@index([clienteId])
  @@index([freelancerId])
  @@index([proyectoId])
  @@index([servicioId])
}

model Conversacion {
  id            Int          @id @default(autoincrement())
  proyectoId    Int?
  servicioId    Int?
  clienteId     Int
  freelancerId  Int
  fechaCreacion DateTime     @default(now())
  Cliente       Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Freelancer    Freelancer   @relation(fields: [freelancerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Proyecto      Proyecto?    @relation(fields: [proyectoId], references: [id], onUpdate: NoAction)
  Servicio      Servicio?    @relation(fields: [servicioId], references: [id], onUpdate: NoAction)
  Mensaje       Mensaje[]
  OfertaChat    OfertaChat[]

  @@unique([proyectoId, clienteId, freelancerId])
  @@index([clienteId])
  @@index([freelancerId])
  @@index([servicioId])
}

model EstadisticaFreelancer {
  id                       Int        @id @default(autoincrement())
  freelancerId             Int
  fecha                    DateTime   @db.Date
  visitasPerfil            Int        @default(0)
  visualizacionesPropuesta Int        @default(0)
  Freelancer               Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([freelancerId, fecha])
}

model EstadisticaProyecto {
  id            Int      @id @default(autoincrement())
  proyectoId    Int
  fecha         DateTime @db.Date
  visitas       Int      @default(0)
  interacciones Int      @default(0)
  Proyecto      Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([proyectoId, fecha])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Factura {
  id            Int       @id @default(autoincrement())
  pagoId        Int       @unique
  numeroFactura String?   @unique @db.VarChar(50)
  cufe          String?   @db.VarChar(255)
  fechaEmision  DateTime?
  estado        String    @default("pendiente") @db.VarChar(20)
  urlPdf        String?
  Pago          Pago      @relation(fields: [pagoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Freelancer {
  id                    Int                     @id
  tituloProfesional     String?                 @db.VarChar(150)
  biografia             String?
  calificacionPromedio  Decimal                 @default(0) @db.Decimal(3, 2)
  Contrato              Contrato[]
  Conversacion          Conversacion[]
  EstadisticaFreelancer EstadisticaFreelancer[]
  User                  User                    @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  FreelancerHabilidad   FreelancerHabilidad[]
  PortafolioItem        PortafolioItem[]
  Propuesta             Propuesta[]
  Servicio              Servicio[]
}

model FreelancerHabilidad {
  freelancerId Int
  habilidadId  Int
  nivel        String?    @db.VarChar(20)
  Freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Habilidad    Habilidad  @relation(fields: [habilidadId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([freelancerId, habilidadId])
  @@index([habilidadId])
}

model Habilidad {
  id                  Int                   @id @default(autoincrement())
  nombre              String                @unique @db.VarChar(100)
  categoriaId         Int?
  FreelancerHabilidad FreelancerHabilidad[]
  Categoria           Categoria?            @relation(fields: [categoriaId], references: [id], onUpdate: NoAction)
  ProyectoHabilidad   ProyectoHabilidad[]

  @@index([categoriaId])
}

model Mensaje {
  id             Int          @id @default(autoincrement())
  conversacionId Int
  emisorId       Int
  contenido      String
  tipo           String       @default("texto") @db.VarChar(20)
  fechaEnvio     DateTime     @default(now())
  leido          Boolean      @default(false)
  Conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  OfertaChat     OfertaChat?
  User           User         @relation(fields: [emisorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([conversacionId, fechaEnvio])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Pago {
  id                 Int      @id @default(autoincrement())
  contratoId         Int
  monto              Decimal  @db.Decimal(12, 2)
  metodoPago         String?  @db.VarChar(30)
  estado             String   @default("pendiente") @db.VarChar(20)
  referenciaPasarela String?  @db.VarChar(100)
  fechaPago          DateTime @default(now())
  Factura            Factura?
  Contrato           Contrato @relation(fields: [contratoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([contratoId])
}

model PortafolioItem {
  id            Int        @id @default(autoincrement())
  freelancerId  Int
  titulo        String     @db.VarChar(150)
  descripcion   String?
  imagenUrl     String?
  enlaceUrl     String?
  fechaCreacion DateTime   @default(now())
  Freelancer    Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([freelancerId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Propuesta {
  id             Int        @id @default(autoincrement())
  proyectoId     Int
  freelancerId   Int
  mensaje        String?
  montoPropuesto Decimal    @db.Decimal(12, 2)
  estado         String     @default("pendiente") @db.VarChar(20)
  fechaEnvio     DateTime   @default(now())
  Contrato       Contrato?
  Freelancer     Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Proyecto       Proyecto   @relation(fields: [proyectoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([proyectoId, freelancerId])
  @@index([freelancerId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Proyecto {
  id                  Int                   @id @default(autoincrement())
  clienteId           Int
  categoriaId         Int?
  titulo              String                @db.VarChar(200)
  descripcion         String
  imagenUrl           String?
  presupuesto         Decimal?              @db.Decimal(12, 2)
  plazoDias           Int?
  estado              String                @default("abierto") @db.VarChar(20)
  fechaPublicacion    DateTime              @default(now())
  Contrato            Contrato[]
  Conversacion        Conversacion[]
  EstadisticaProyecto EstadisticaProyecto[]
  Propuesta           Propuesta[]
  Categoria           Categoria?            @relation(fields: [categoriaId], references: [id], onUpdate: NoAction)
  Cliente             Cliente               @relation(fields: [clienteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ProyectoHabilidad   ProyectoHabilidad[]
  Reporte             Reporte[]

  @@index([categoriaId])
  @@index([clienteId])
  @@index([estado])
}

model ProyectoHabilidad {
  proyectoId  Int
  habilidadId Int
  Habilidad   Habilidad @relation(fields: [habilidadId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Proyecto    Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([proyectoId, habilidadId])
  @@index([habilidadId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Reporte {
  id                                    Int       @id @default(autoincrement())
  usuarioReportaId                      Int
  usuarioReportadoId                    Int?
  proyectoId                            Int?
  adminId                               Int?
  motivo                                String    @db.VarChar(100)
  descripcion                           String?
  estado                                String    @default("pendiente") @db.VarChar(20)
  fecha                                 DateTime  @default(now())
  User_Reporte_adminIdToUser            User?     @relation("Reporte_adminIdToUser", fields: [adminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Proyecto                              Proyecto? @relation(fields: [proyectoId], references: [id], onUpdate: NoAction)
  User_Reporte_usuarioReportaIdToUser   User      @relation("Reporte_usuarioReportaIdToUser", fields: [usuarioReportaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User_Reporte_usuarioReportadoIdToUser User?     @relation("Reporte_usuarioReportadoIdToUser", fields: [usuarioReportadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([estado])
}

model Rol {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(30)
  User   User[]
}

/// Servicio publicado por un freelancer (estilo Fiverr): el cliente lo explora y lo solicita.
model Servicio {
  id            Int            @id @default(autoincrement())
  freelancerId  Int
  categoriaId   Int?
  titulo        String         @db.VarChar(150)
  descripcion   String
  precio        Decimal        @db.Decimal(12, 2)
  imagenUrl     String?
  estado        String         @default("activo") @db.VarChar(20)
  fechaCreacion DateTime       @default(now())
  Categoria     Categoria?     @relation(fields: [categoriaId], references: [id], onUpdate: NoAction)
  Contrato      Contrato[]
  Conversacion  Conversacion[]
  Freelancer    Freelancer     @relation(fields: [freelancerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([categoriaId])
  @@index([estado])
  @@index([freelancerId])
}

/// Oferta o contraoferta de un monto dentro de una conversación (estilo Fiverr).
/// estados: pendiente | aceptada | rechazada | contraofertada | expirada
model OfertaChat {
  id              Int          @id @default(autoincrement())
  conversacionId  Int
  mensajeId       Int          @unique
  monto           Decimal      @db.Decimal(12, 2)
  descripcion     String?
  estado          String       @default("pendiente") @db.VarChar(20)
  ofertaPadreId   Int?         @unique
  fechaEnvio      DateTime     @default(now())
  fechaExpiracion DateTime?
  Contrato        Contrato?
  Conversacion    Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Mensaje         Mensaje      @relation(fields: [mensajeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Contraoferta    OfertaChat?  @relation("Contraofertas")
  OfertaPadre     OfertaChat?  @relation("Contraofertas", fields: [ofertaPadreId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([conversacionId])
}

/// Publicación del blog personal de un usuario (estilo Instagram).
model Publicacion {
  id                 Int                  @id @default(autoincrement())
  autorId            Int
  titulo             String?              @db.VarChar(150)
  contenido          String
  imagenUrl          String?
  estado             String               @default("publicado") @db.VarChar(20)
  fechaPublicacion   DateTime             @default(now())
  Autor              User                 @relation(fields: [autorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  MeGustaPublicacion MeGustaPublicacion[]

  @@index([autorId])
  @@index([fechaPublicacion])
}

/// Like de una publicación: máximo un like por usuario.
model MeGustaPublicacion {
  publicacionId Int
  usuarioId     Int
  fecha         DateTime    @default(now())
  Publicacion   Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Usuario       User        @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([publicacionId, usuarioId])
  @@index([usuarioId])
}
