NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/firstgig
JWT_SECRET=cambia-este-secreto-largo
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
SWAGGER_SERVER_URL=http://localhost:4000
COMISION_PLATAFORMA_PORCENTAJE=15
COMISION_CLIENTE_PORCENTAJE=3
SEED_DEMO_USER=false

# Mercado Pago (CHECKOUT PRO). En desarrollo, si no hay token se usa modo simulado.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_API_URL=https://api.mercadopago.com

# Secreto para hashear códigos de verificación/recuperación (si falta se usa JWT_SECRET)
CODIGOS_SECRETO=

# Proveedor de correo (brevo | smtp)
EMAIL_PROVIDER=smtp

# Envio de correo con Brevo API (recomendado en Render/cloud)
BREVO_API_KEY=tu-brevo-api-key
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
EMAIL_FROM=no-reply@firstgig.com
EMAIL_FROM_NAME=FirstGig

# Envio de correo con Gmail SMTP (desarrollo local)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password-de-gmail
SMTP_FROM=FirstGig <tu-correo@gmail.com>

# Google OAuth
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
